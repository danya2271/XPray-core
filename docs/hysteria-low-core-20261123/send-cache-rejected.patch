+    #[test]
+    fn small_drained_metadata_is_reused_and_discard_releases_it() {
+        let mut buf = SendBuffer::new();
+        let mut capacity = 0;
+        for cycle in 0..64u64 {
+            buf.write(Bytes::from_static(b"work"));
+            if cycle != 0 {
+                assert_eq!(buf.unacked_segments.capacity(), capacity);
+            }
+            capacity = buf.unacked_segments.capacity();
+            buf.poll_transmit(32);
+            buf.ack(cycle * 4..cycle * 4 + 4);
+            assert!(buf.unacked_segments.is_empty());
+            assert_eq!(buf.unacked_len, 0);
+            assert!(buf.unacked_segments.capacity() <= CACHED_SEGMENTS);
+        }
+        buf.discard();
+        assert_eq!(buf.offset(), 256);
+        assert_eq!(buf.unacked_segments.capacity(), 0);
+    }
+
+    #[test]
+    #[ignore = "manual repeated-write/ACK CPU benchmark"]
+    fn benchmark_repeated_small_write_ack() {
+        let reference = std::env::var_os("XHYS_SEND_CACHE_REFERENCE").is_some();
+        let mut buf = SendBuffer::new();
+        let started = std::time::Instant::now();
+        for cycle in 0..524288u64 {
+            buf.write(Bytes::from_static(b"work"));
+            buf.poll_transmit(32);
+            buf.ack(cycle * 4..cycle * 4 + 4);
+            if reference {
+                buf.unacked_segments.shrink_to_fit();
+            }
+            std::hint::black_box(&buf);
+        }
+        println!(
+            "reference={reference} cached_metadata_bytes={} ns_per_cycle={:.3}",
+            buf.unacked_segments.capacity() * std::mem::size_of::<Bytes>(),
+            started.elapsed().as_nanos() as f64 / 524288.
+        );
+    }
